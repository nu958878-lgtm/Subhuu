
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>SUBHUU | Portfolio</title>

<style>
* {
  margin: 0;
  padding: 0;
  box-sizing: border-box;
  scroll-behavior: smooth;
}

body {
  background: #08090d;
  color: #fff;
  font-family: Arial, sans-serif;
}

:root {
  --accent: #a78bfa;
}

nav {
  position: fixed;
  top: 0;
  width: 100%;
  padding: 20px 8%;
  display: flex;
  justify-content: space-between;
  align-items: center;
  background: rgba(8,9,13,.9);
  backdrop-filter: blur(15px);
  z-index: 100;
  border-bottom: 1px solid #222;
}

.logo {
  font-size: 25px;
  font-weight: bold;
  letter-spacing: 3px;
  color: var(--accent);
}

nav a {
  color: #ddd;
  text-decoration: none;
  margin-left: 25px;
  font-size: 14px;
  transition: .3s;
}

nav a:hover {
  color: var(--accent);
}

.hero {
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;
  text-align: center;
  padding: 100px 20px 40px;
  background:
    radial-gradient(circle at 50% 40%, #39245d55, transparent 45%);
}

.tag {
  color: var(--accent);
  border: 1px solid #66508b;
  padding: 9px 18px;
  border-radius: 30px;
  font-size: 13px;
  margin-bottom: 25px;
}

.hero h1 {
  font-size: clamp(55px, 10vw, 100px);
  letter-spacing: 5px;
}

.hero h1 span {
  color: var(--accent);
}

.hero p {
  color: #aaa;
  max-width: 550px;
  line-height: 1.8;
  margin: 20px 0 30px;
}

.btn {
  display: inline-block;
  padding: 14px 28px;
  background: var(--accent);
  color: #08090d;
  border-radius: 8px;
  text-decoration: none;
  font-weight: bold;
  transition: .3s;
}

.btn:hover {
  transform: translateY(-4px);
  box-shadow: 0 0 25px #a78bfa77;
}

section {
  padding: 100px 8%;
}

.heading {
  font-size: 38px;
  margin-bottom: 35px;
}

.heading span {
  color: var(--accent);
}

.about {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 45px;
  align-items: center;
}

.about-card, .card {
  background: #11131b;
  border: 1px solid #262634;
  padding: 30px;
  border-radius: 15px;
  transition: .3s;
}

.about-card:hover, .card:hover {
  border-color: var(--accent);
  transform: translateY(-5px);
}

.about p {
  color: #aaa;
  line-height: 1.9;
}

.skills, .projects {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
  gap: 20px;
}

.card h3 {
  color: var(--accent);
  margin-bottom: 12px;
}

.card p {
  color: #aaa;
  line-height: 1.7;
}

.skill {
  text-align: center;
}

.contact {
  text-align: center;
  background: radial-gradient(circle, #39245d33, transparent 65%);
}

.contact p {
  color: #aaa;
  margin-bottom: 25px;
}

footer {
  padding: 25px;
  text-align: center;
  border-top: 1px solid #222;
  color: #777;
  font-size: 13px;
}

.reveal {
  opacity: 0;
  transform: translateY(25px);
  transition: .8s;
}

.reveal.show {
  opacity: 1;
  transform: translateY(0);
}

@media(max-width: 700px) {
  nav {
    padding: 18px 5%;
  }

  nav a {
    margin-left: 10px;
    font-size: 11px;
  }

  .about {
    grid-template-columns: 1fr;
  }

  section {
    padding: 75px 6%;
  }

  .heading {
    font-size: 30px;
  }
}
</style>
</head>

<body>

<nav>
  <div class="logo">SUBHUU.</div>
  <div>
    <a href="#home">Home</a>
    <a href="#about">About</a>
    <a href="#skills">Skills</a>
    <a href="#projects">Projects</a>
    <a href="#contact">Contact</a>
  </div>
</nav>

<!-- HOME -->
<div class="hero" id="home">
  <div class="tag">WELCOME TO MY PORTFOLIO</div>

  <h1>I'm <span>SUBHUU</span></h1>

  <p>
    Aspiring Software Developer.
    I love technology, coding and creating
    beautiful digital experiences.
  </p>

  <a href="#about" class="btn">Explore My World →</a>
</div>

<!-- ABOUT -->
<section id="about" class="reveal">
  <h2 class="heading">About <span>Me</span></h2>

  <div class="about">
    <div class="about-card">
      <h3>Who Am I?</h3>
      <p>
        Hello! I'm SUBHUU. I'm an aspiring developer
        who enjoys learning programming and building
        creative websites and applications.
        My goal is to become a professional
        software developer.
      </p>
    </div>

    <div class="about-card">
      <h3>My Vision</h3>
      <p>
        I believe every great developer starts
        with curiosity. I'm learning new skills,
        improving my creativity and turning
        ideas into reality.
      </p>
    </div>
  </div>
</section>

<!-- SKILLS -->
<section id="skills" class="reveal">
  <h2 class="heading">My <span>Skills</span></h2>

  <div class="skills">
    <div class="card skill">
      <h3>HTML</h3>
      <p>Website Structure</p>
    </div>

    <div class="card skill">
      <h3>CSS</h3>
      <p>Website Design</p>
    </div>

    <div class="card skill">
      <h3>JavaScript</h3>
      <p>Website Interactions</p>
    </div>

    <div class="card skill">
      <h3>Python</h3>
      <p>Programming</p>
    </div>
  </div>
</section>

<!-- PROJECTS -->
<section id="projects" class="reveal">
  <h2 class="heading">My <span>Projects</span></h2>

  <div class="projects">
    <div class="card">
      <h3>Project 01</h3>
      <p>My personal portfolio website.</p>
    </div>

    <div class="card">
      <h3>Project 02</h3>
      <p>A creative website project coming soon.</p>
    </div>

    <div class="card">
      <h3>Project 03</h3>
      <p>My future application project.</p>
    </div>
  </div>
</section>

<!-- CONTACT -->
<section id="contact" class="contact reveal">
  <h2 class="heading">Let's <span>Connect</span></h2>

  <p>Have an idea? Let's create something amazing.</p>

  <a href="mailto:your@email.com" class="btn">
    Contact Me →
  </a>
</section>

<footer>
  © 2026 SUBHUU. All Rights Reserved.
  <br><br>
  Designed with passion.
</footer>

<script>
const observer = new IntersectionObserver((entries) => {
  entries.forEach(entry => {
    if (entry.isIntersecting) {
      entry.target.classList.add("show");
    }
  });
}, { threshold: 0.15 });

document.querySelectorAll(".reveal").forEach(section => {
  observer.observe(section);
});
</script>

</body>
</html>
